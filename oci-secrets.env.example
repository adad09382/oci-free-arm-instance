# Copy to oci-secrets.env and fill in the values. Do not commit the real file.
OCI_CLI_TENANCY=
OCI_CLI_USER=
OCI_CLI_REGION=us-phoenix-1
OCI_CLI_FINGERPRINT=

# Prefer OCI_CLI_KEY_FILE for local use. OCI_CLI_KEY_CONTENT is also supported.
OCI_CLI_KEY_FILE=~/.oci/oci_api_key.pem
# OCI_CLI_KEY_CONTENT="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

OCI_COMPARTMENT_ID=
OCI_SUBNET_ID=
AD_NAME=
# Optional: comma-separated AD round-robin list. If set, this overrides AD_NAME.
AD_NAMES=
IMAGE_ID=
SSH_PUBLIC_KEY=
DISCORD_WEBHOOK_URL=

# Optional tuning.
# Always Free A1.Flex quota is 2 OCPUs / 12GB total (reduced from 4/24 in mid-2026).
# Any single shape below must stay within that total.
INSTANCE_DISPLAY_NAME=free-arm-instance
OCPUS=2
MEMORY_GBS=12
# Optional: comma-separated shape round-robin list. If set, this overrides OCPUS/MEMORY_GBS.
# Cycles between the full quota and a smaller request, which tends to land capacity sooner.
SHAPE_CONFIGS=2:12,1:6
BOOT_VOLUME_GBS=50
RETRY_INTERVAL_SECONDS=30
DISCORD_CAPACITY_EVERY=10
LAUNCHD_LABEL=com.wade.oci-arm-retry
